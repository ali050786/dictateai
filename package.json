{
  "name": "dictateai",
  "productName": "DictateAI",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source voice dictation for macOS — local Whisper STT + AI formatting",
  "keywords": [
    "voice",
    "dictation",
    "whisper",
    "speech-to-text",
    "macos"
