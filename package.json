{
  "name": "utter",
  "productName": "Utter",
  "version": "0.2.2",
  "private": true,
  "description": "Open-source voice dictation for macOS — local Whisper STT + AI formatting",
  "keywords": [
    "voice",
    "dictation",
    "whisper",
    "speech-to-text",
    "macos"
  ],
  "license": "MIT",
  "author": "Sikandar Ali <ali050786@gmail.com>",
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "build:native": "node-gyp rebuild --directory native/text-injection",
    "build:engines": "scripts/build-engines.sh",
    "start": "electron-forge start",
    "prepackage": "npm run build:native && npm run build:engines",
    "package": "electron-forge package",
    "premake": "npm run build:native && npm run build:engines",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/",
    "build:sounds": "node scripts/build-sounds.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "test:cleanup": "node --no-warnings scripts/test-basic-cleanup.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-webpack": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "44.9.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "node-addon-api": "^8.9.2",
    "openai": "^7.36.0"
  },
  "allowScripts": {
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true
  }
}
